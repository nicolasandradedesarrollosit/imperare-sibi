---
import Logo from '../ui/Logo.astro';
import { SECTIONS } from '../../config/site';
import { sectionUrl } from '../../lib/content';

interface Props {
  activeSection?: string;
}
const { activeSection } = Astro.props;
// aria-current: "page" on the category page itself (and its pagination),
// "true" on articles that belong to the category.
const currentFor = (slug: string) => {
  if (activeSection !== slug) return undefined;
  const path = Astro.url.pathname;
  const base = sectionUrl(slug);
  return path === base || /^\d+\/$/.test(path.slice(base.length)) ? 'page' : 'true';
};
---

<header>
  <div class="wrap flex items-center justify-between gap-6 py-4 md:py-5">
    <a href="/" class="text-base no-underline md:text-lg" aria-label="Imperare Sibi, ir a la portada">
      <Logo />
    </a>

    <div class="flex items-center gap-6">
      <!--
        Today's date is filled in by the browser (the site is static, so a build-time
        date would freeze on deploy day). Width is reserved to avoid layout shift.
      -->
      <time data-today class="hidden min-w-56 text-right text-xs text-muted md:block"></time>
      <script is:inline>
        (function () {
          var el = document.querySelector('[data-today]');
          if (!el) return;
          var now = new Date();
          var text = new Intl.DateTimeFormat('es-AR', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric',
            timeZone: 'America/Argentina/Buenos_Aires',
          }).format(now);
          el.textContent = text.charAt(0).toUpperCase() + text.slice(1);
          el.setAttribute('datetime', now.toISOString().slice(0, 10));
        })();
      </script>
      <a href="/buscar/" class="link text-sm font-medium text-ink-2">Buscar</a>
      <!-- Hidden on phones: the helpline bar above already links to /ayuda. -->
      <a href="/ayuda/" class="btn btn--ghost hidden px-3.5 py-1.5 text-xs sm:inline-flex">Pedir ayuda</a>
    </div>
  </div>

  <nav class="sticky top-0 z-30 border-y border-rule bg-paper/95 backdrop-blur" aria-label="Categorías principales">
    <div
      class="wrap overflow-x-auto [scrollbar-width:none] max-md:pr-8 max-md:[mask-image:linear-gradient(to_right,#000_85%,transparent)] [&::-webkit-scrollbar]:hidden"
    >
      <ul role="list" class="flex w-max min-w-full gap-7">
        {
          SECTIONS.map((s) => (
            <li>
              <a
                href={sectionUrl(s.slug)}
                aria-current={currentFor(s.slug)}
                class="-mb-px block border-b-2 border-transparent pt-3 pb-2.5 text-sm font-medium whitespace-nowrap text-ink-2 no-underline hover:text-accent aria-[current]:border-accent aria-[current]:text-accent"
              >
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>
