---
import Logo from '../ui/Logo.astro';
import PhoneIcon from '../ui/PhoneIcon.astro';
import { SECTIONS } from '../../config/site';
import { sectionUrl } from '../../lib/content';

interface Props {
  activeSection?: string;
}
const { activeSection } = Astro.props;
---

<header>
  <div class="wrap grid grid-cols-[1fr_auto_1fr] items-center gap-4 py-5 md:py-7">
    <!--
      Today's date is filled in by the browser (the site is static, so a build-time
      date would freeze on deploy day). Width is reserved to avoid layout shift.
    -->
    <time data-today class="hidden min-w-64 text-xs text-muted md:block"></time>
    <script is:inline>
      (function () {
        var el = document.querySelector('[data-today]');
        if (!el) return;
        var now = new Date();
        var text = new Intl.DateTimeFormat('es-AR', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
          timeZone: 'America/Argentina/Buenos_Aires',
        }).format(now);
        el.textContent = text.charAt(0).toUpperCase() + text.slice(1);
        el.setAttribute('datetime', now.toISOString().slice(0, 10));
      })();
    </script>

    <a href="/" class="col-start-2 text-2xl no-underline md:text-[2.125rem]" aria-label="Imperare Sibi, ir a la portada">
      <Logo />
    </a>

    <!-- Hidden on phones: the helpline bar above already links to /ayuda, and the logo stays alone at the centre. -->
    <div class="col-start-3 hidden justify-end sm:flex">
      <a
        href="/ayuda/"
        class="chip px-3 py-1.5 text-xs font-semibold"
      >
        <PhoneIcon class="size-3.5" />
        Pedir ayuda
      </a>
    </div>
  </div>

  <nav class="sticky top-0 z-30 border-y border-rule bg-paper/95 backdrop-blur" aria-label="Categorías">
    <div
      class="wrap overflow-x-auto [scrollbar-width:none] max-md:pr-8 max-md:[mask-image:linear-gradient(to_right,#000_85%,transparent)] [&::-webkit-scrollbar]:hidden"
    >
      <ul role="list" class="mx-auto flex w-max min-w-full gap-6 md:justify-center">
        {
          SECTIONS.map((s) => (
            <li>
              <a
                href={sectionUrl(s.slug)}
                aria-current={activeSection === s.slug ? 'page' : undefined}
                class="block border-b-2 border-transparent pt-3 pb-2.5 text-sm font-semibold whitespace-nowrap no-underline hover:border-accent/40 hover:text-accent-dark aria-[current=page]:border-accent"
              >
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>
