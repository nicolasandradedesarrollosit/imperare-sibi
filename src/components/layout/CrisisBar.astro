---
import { LINEAS_AYUDA } from '../../config/site';
const [principal, pais] = LINEAS_AYUDA;
---

<aside class="crisis" aria-label="Líneas de ayuda">
  <div class="container crisis__inner">
    <p>
      <strong>¿Necesitás hablar con alguien ahora?</strong>
      <span class="crisis__lines">
        Llamá al <a href={`tel:${principal.tel}`}>{principal.numero}</a> (CABA y GBA) o al
        <a href={`tel:${pais.tel}`}>{pais.numero}</a> (todo el país). Es gratuito.
      </span>
    </p>
    <a class="crisis__more" href="/ayuda/">Más recursos</a>
  </div>
</aside>

<style>
  .crisis {
    background: var(--c-crisis-bg);
    color: var(--c-crisis-ink);
    font-size: var(--fs-sm);
  }
  .crisis__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-4);
    padding-block: var(--sp-2);
  }
  .crisis a {
    color: inherit;
    font-weight: 600;
  }
  .crisis__lines {
    opacity: 0.9;
  }
  .crisis__more {
    white-space: nowrap;
  }
</style>
