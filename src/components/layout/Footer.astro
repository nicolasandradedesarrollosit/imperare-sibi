---
import Logo from '../ui/Logo.astro';
import { HELPLINES, INSTITUTIONAL_NAV, LEGAL_NAV, SECTIONS, SITE } from '../../config/site';
import { sectionUrl } from '../../lib/content';

const year = new Date().getFullYear();
const columns = [
  { title: 'Categorías', links: SECTIONS.map((s) => ({ href: sectionUrl(s.slug), label: s.name })) },
  { title: 'El blog', links: [...INSTITUTIONAL_NAV, { href: '/rss.xml', label: 'RSS' }] },
  { title: 'Legales', links: [...LEGAL_NAV] },
];
---

<footer class="section border-t border-rule text-sm text-ink-2">
  <div class="wrap py-12">
    <div class="grid gap-2">
      <a href="/" class="justify-self-start text-base no-underline" aria-label="Imperare Sibi, ir a la portada"><Logo /></a>
      <p class="text-muted">{SITE.tagline}</p>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-rule pt-10 md:grid-cols-4">
      {
        columns.map((col) => (
          <nav aria-label={`${col.title} (pie de página)`}>
            <h2 class="label mb-3 text-muted">{col.title}</h2>
            <ul role="list" class="grid gap-2">
              {col.links.map((l) => (
                <li>
                  <a class="link" href={l.href}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      <div>
        <h2 class="label mb-3 text-muted">Líneas de ayuda</h2>
        <ul role="list" class="grid gap-2">
          {
            HELPLINES.map((l) => (
              <li class="grid">
                <a class="font-semibold text-ink link tabular-nums" href={l.href}>
                  {l.number}
                </a>
                <span class="text-xs text-muted">{l.name}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-10 max-w-3xl border-t border-rule pt-6 text-xs text-muted">{SITE.disclaimer}</p>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-muted">
      <span>© {year} {SITE.name}</span>
      <a class="link" href={SITE.social.instagram} rel="me noopener">Instagram</a>
      <a class="link" href={SITE.social.x} rel="me noopener">X</a>
      <a class="link" href={SITE.social.linkedin} rel="me noopener">LinkedIn</a>
    </div>
  </div>
</footer>
