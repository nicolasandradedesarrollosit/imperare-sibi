---
import { tagUrl } from '../../lib/content';
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul role="list" class="tags" aria-label="Temas">
      {tags.map((t) => (
        <li>
          <a href={tagUrl(t)}>{t}</a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .tags a {
    display: inline-block;
    padding: 0.3em 0.8em;
    font-size: var(--fs-xs);
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    color: var(--c-ink-soft);
  }
  .tags a:hover {
    border-color: var(--c-sage);
    color: var(--c-sage-strong);
  }
</style>
