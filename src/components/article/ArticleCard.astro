---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { getSection, TYPE_LABEL } from '../../config/site';
import { articleUrl, type Article } from '../../lib/content';
import { formatShortDate } from '../../lib/dates';

/**
 * lead:     main story of the front page: 16:9 photo, large headline, standfirst.
 * stack:    photo on top, headline below.
 * row:      headline left, thumbnail right (dense lists).
 * wide:     photo left, headline and standfirst right.
 * text:     no photo.
 * Variant styles live in src/styles/index.css (.card--*).
 */
type Variant = 'lead' | 'stack' | 'row' | 'wide' | 'text';

interface Props {
  article: Article;
  variant?: Variant;
  /** Heading level, to keep the page outline correct. */
  as?: 'h2' | 'h3';
  /** Above-the-fold image (LCP): eager load and high priority. */
  priority?: boolean;
  showDek?: boolean;
  showSection?: boolean;
  /** `sizes` attribute for the image; defaults per variant. */
  sizes?: string;
}

const {
  article,
  variant = 'stack',
  as: Heading = 'h3',
  priority = false,
  showDek = variant === 'lead' || variant === 'wide',
  showSection = true,
  sizes,
} = Astro.props;

const { data } = article;
const url = articleUrl(article);
const section = getSection(data.section)!;
const author = await getEntry(data.author);

const IMAGE = {
  lead: { width: 1200, height: 675, widths: [640, 960, 1200], sizes: '(max-width: 64rem) 100vw, 48rem' },
  stack: { width: 640, height: 427, widths: [320, 480, 640], sizes: '(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 24rem' },
  row: { width: 320, height: 213, widths: [200, 320], sizes: '8.5rem' },
  wide: { width: 960, height: 640, widths: [480, 720, 960], sizes: '(max-width: 48rem) 100vw, 42rem' },
  text: undefined,
}[variant];
const blockKicker = variant === 'lead' || variant === 'row';
---

<article class:list={['card', `card--${variant}`]}>
  {
    IMAGE && (
      <a href={url} class="card__media" tabindex="-1" aria-hidden="true">
        <Image
          src={data.image}
          alt=""
          width={IMAGE.width}
          height={IMAGE.height}
          widths={IMAGE.widths}
          sizes={sizes ?? IMAGE.sizes}
          fit="cover"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
        />
      </a>
    )
  }
  <div class="card__body">
    <Heading class="card__title">
      <a href={url}>
        {
          showSection && (
            <span class:list={['kicker', { 'kicker--block': blockKicker }]}>
              {section.name}
              <span class="kicker__sep" aria-hidden="true">
                {' / '}
              </span>
            </span>
          )
        }
        {data.title}
      </a>
    </Heading>
    {showDek && <p class="card__dek">{data.description}</p>}
    <p class="meta">
      {data.type !== 'news' && <span class="card__type">{TYPE_LABEL[data.type]}</span>}
      {author && variant !== 'row' && <span>{author.data.name}</span>}
      <time datetime={data.publishedAt.toISOString()}>{formatShortDate(data.publishedAt)}</time>
    </p>
  </div>
</article>
