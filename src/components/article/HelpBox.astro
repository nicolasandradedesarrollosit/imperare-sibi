---
import { LINEAS_AYUDA } from '../../config/site';
---

<aside class="help" aria-labelledby="help-title">
  <h2 id="help-title">Si estás pasando por un momento difícil</h2>
  <p>No estás solo ni sola. Hay personas preparadas para escucharte, las 24 horas y de forma gratuita:</p>
  <ul role="list">
    {
      LINEAS_AYUDA.map((l) => (
        <li>
          <a href={`tel:${l.tel}`}>{l.numero}</a> — {l.nombre}. <span>{l.detalle}.</span>
        </li>
      ))
    }
  </ul>
  <p><a href="/ayuda/">Ver todos los recursos de ayuda por provincia</a></p>
</aside>

<style>
  .help {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-5);
    border: 1px solid var(--c-sage);
    border-left-width: 4px;
    border-radius: var(--radius);
    background: var(--c-surface);
    font-size: var(--fs-sm);
  }
  .help h2 {
    font-size: var(--fs-lg);
  }
  .help ul {
    display: grid;
    gap: var(--sp-2);
  }
  .help a {
    font-weight: 600;
    color: var(--c-sage-strong);
  }
  .help span {
    color: var(--c-muted);
  }
</style>
