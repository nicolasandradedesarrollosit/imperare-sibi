---
import { formatDate } from '../../lib/dates';

/** Dateline under the headline. The blog is anonymous, so no person is ever named here. */
interface Props {
  publishedAt: Date;
  updatedAt?: Date;
  minutes: number;
}
const { publishedAt, updatedAt, minutes } = Astro.props;
---

<p class="meta justify-self-stretch border-t border-rule pt-4">
  <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
  {
    updatedAt && (
      <span>
        Actualizado el <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
      </span>
    )
  }
  <span>{minutes} min de lectura</span>
</p>
