---
import { Image } from 'astro:assets';
import { authorUrl, type Author } from '../../lib/content';
import { formatDate } from '../../lib/dates';

interface Props {
  author: Author;
  publishedAt: Date;
  updatedAt?: Date;
  minutes: number;
}
const { author, publishedAt, updatedAt, minutes } = Astro.props;
---

<div class="byline">
  {author.data.photo && <Image src={author.data.photo} alt="" width={44} height={44} class="byline__photo" />}
  <div class="byline__text">
    <p>
      Por <a href={authorUrl(author.id)} rel="author">{author.data.name}</a>
    </p>
    <p class="byline__meta">
      <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
      {
        updatedAt && (
          <span>
            Actualizado el <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
          </span>
        )
      }
      <span>{minutes} min de lectura</span>
    </p>
  </div>
</div>

<style>
  .byline {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--fs-sm);
  }
  .byline__photo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }
  .byline a {
    font-weight: 700;
    text-decoration: none;
  }
  .byline a:hover {
    text-decoration: underline;
  }
  .byline__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .byline__meta > * + *::before {
    content: '·';
    margin-right: var(--sp-2);
  }
</style>
