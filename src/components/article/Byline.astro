---
import { Image } from 'astro:assets';
import { authorUrl, type Author } from '../../lib/content';
import { formatDate } from '../../lib/dates';

interface Props {
  author: Author;
  publishedAt: Date;
  updatedAt?: Date;
  minutes: number;
}
const { author, publishedAt, updatedAt, minutes } = Astro.props;
---

<div class="flex items-center justify-center gap-3 text-sm">
  {author.data.photo && <Image src={author.data.photo} alt="" width={44} height={44} class="size-11 rounded-full object-cover" />}
  <div class="grid justify-items-center gap-0.5">
    <p>
      Por <a class="font-bold link" href={authorUrl(author.id)} rel="author">{author.data.name}</a>
    </p>
    <p class="meta justify-center">
      <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
      {
        updatedAt && (
          <span>
            Actualizado el <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
          </span>
        )
      }
      <span>{minutes} min de lectura</span>
    </p>
  </div>
</div>
