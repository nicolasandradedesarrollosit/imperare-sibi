---
import { Image } from 'astro:assets';
import type { Articulo } from '../../lib/content';
import { SECCIONES } from '../../config/site';

interface Props {
  articulo: Articulo;
  /** Ancho máximo aproximado en px para generar srcset. */
  width?: number;
  /** true en la imagen principal (LCP): carga inmediata y alta prioridad. */
  priority?: boolean;
  sizes?: string;
}
const { articulo, width = 800, priority = false, sizes = '(max-width: 48rem) 100vw, 50vw' } = Astro.props;
const { imagen, imagenAlt, seccion } = articulo.data;
const tono = Math.max(0, SECCIONES.findIndex((s) => s.slug === seccion));
---

{
  imagen ? (
    <Image
      class="media"
      src={imagen}
      alt={imagenAlt ?? ''}
      width={width}
      widths={[Math.round(width / 2), width, Math.min(width * 2, imagen.width)]}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      format="avif"
    />
  ) : (
    <div class:list={['media', 'media--placeholder', `tono-${tono}`]} aria-hidden="true" />
  )
}

<style>
  .media {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--c-surface-2);
  }
  .media--placeholder {
    --h: 150;
    background:
      radial-gradient(circle at 78% 30%, hsl(var(--h) 30% 55% / 0.35) 0 18%, transparent 18.5%),
      radial-gradient(circle at 78% 30%, transparent 0 30%, hsl(var(--h) 25% 50% / 0.18) 30.5% 31.5%, transparent 32%),
      radial-gradient(circle at 78% 30%, transparent 0 44%, hsl(var(--h) 25% 50% / 0.12) 44.5% 45.5%, transparent 46%),
      linear-gradient(135deg, hsl(var(--h) 28% 88%), hsl(calc(var(--h) + 25) 30% 80%));
  }
  .tono-1 { --h: 25; }
  .tono-2 { --h: 200; }
  .tono-3 { --h: 42; }
  .tono-4 { --h: 170; }
  .tono-5 { --h: 95; }
  @media (prefers-color-scheme: dark) {
    .media--placeholder {
      background:
        radial-gradient(circle at 78% 30%, hsl(var(--h) 25% 45% / 0.35) 0 18%, transparent 18.5%),
        radial-gradient(circle at 78% 30%, transparent 0 30%, hsl(var(--h) 25% 60% / 0.18) 30.5% 31.5%, transparent 32%),
        linear-gradient(135deg, hsl(var(--h) 18% 18%), hsl(calc(var(--h) + 25) 18% 24%));
    }
  }
</style>
