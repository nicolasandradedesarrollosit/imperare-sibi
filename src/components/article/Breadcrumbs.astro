---
import type { Crumb } from '../../lib/seo';

interface Props {
  items: Crumb[];
  class?: string;
}
const { items, class: className } = Astro.props;
// The current page is already the <h1>; only ancestors are shown as links.
const trail = items.slice(0, -1);
---

<nav aria-label="Ruta de navegación" class={className}>
  <ol role="list" class="flex flex-wrap justify-center gap-2 text-sm font-semibold">
    {
      trail.map((it, i) => (
        <li class="flex gap-2">
          {i > 0 && (
            <span class="font-normal text-muted" aria-hidden="true">
              ›
            </span>
          )}
          <a href={it.href} class="link text-accent">
            {it.name}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
