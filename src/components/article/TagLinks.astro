---
import { tagUrl } from '../../lib/content';
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <p class="text-sm">
      <span class="label mr-2">Temas</span>
      {tags.map((t, i) => (
        <>
          <a class="link-accent" href={tagUrl(t)}>
            {t}
          </a>
          {i < tags.length - 1 && ', '}
        </>
      ))}
    </p>
  )
}
