---
import Breadcrumbs from './Breadcrumbs.astro';
import Byline from './Byline.astro';
import { TYPE_LABEL } from '../../config/site';
import { readingTime, type Article } from '../../lib/content';
import type { Crumb } from '../../lib/seo';

/** Article header (left-aligned with the lead photo): breadcrumbs, type, headline, standfirst and dateline. */
interface Props {
  article: Article;
  crumbs: Crumb[];
}
const { article, crumbs } = Astro.props;
const { data } = article;
---

<header class="wrap pt-10 pb-8">
  <div class="mx-auto grid max-w-5xl justify-items-start gap-4">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <Breadcrumbs items={crumbs} />
      {data.type !== 'news' && <span class="text-2xs font-semibold tracking-wider text-muted uppercase">{TYPE_LABEL[data.type]}</span>}
    </div>
    <h1 class="max-w-4xl text-display">{data.title}</h1>
    <p class="max-w-3xl text-lg leading-snug text-muted">{data.description}</p>
    <Byline publishedAt={data.publishedAt} updatedAt={data.updatedAt} minutes={readingTime(article.body)} />
  </div>
</header>
