---
import { Image } from 'astro:assets';
import type { Article } from '../../lib/content';

/**
 * Lead photo of an article (LCP element): eager, high priority. The description lives
 * in `alt`; the caption only carries the credit, so screen readers don't hear it twice.
 */
interface Props {
  article: Article;
}
const { data } = Astro.props.article;
---

<figure class="wrap">
  <div class="mx-auto max-w-5xl">
    <Image
      src={data.image}
      alt={data.imageAlt}
      width={1400}
      height={788}
      widths={[640, 960, 1400]}
      sizes="(max-width: 64rem) 100vw, 64rem"
      fit="cover"
      loading="eager"
      fetchpriority="high"
      class="aspect-video w-full bg-paper-alt object-cover"
    />
    {data.imageCredit && <figcaption class="mt-2 text-right text-xs text-muted">{data.imageCredit}</figcaption>}
  </div>
</figure>
