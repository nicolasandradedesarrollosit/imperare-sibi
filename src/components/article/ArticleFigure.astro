---
import { Image } from 'astro:assets';
import type { Article } from '../../lib/content';

/** Lead photo of an article (LCP element): eager, high priority, with caption and credit. */
interface Props {
  article: Article;
}
const { data } = Astro.props.article;
---

<figure class="wrap">
  <div class="mx-auto max-w-5xl">
    <Image
      src={data.image}
      alt={data.imageAlt}
      width={1400}
      height={788}
      widths={[640, 960, 1400]}
      sizes="(max-width: 64rem) 100vw, 64rem"
      fit="cover"
      loading="eager"
      fetchpriority="high"
      class="aspect-video w-full rounded-sm bg-paper-alt object-cover"
    />
    <figcaption class="meta mt-2 justify-center text-center">
      <span>{data.imageAlt}</span>
      {data.imageCredit && <span>{data.imageCredit}</span>}
    </figcaption>
  </div>
</figure>
