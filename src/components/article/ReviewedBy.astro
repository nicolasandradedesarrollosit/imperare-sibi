---
import { authorUrl, type Author } from '../../lib/content';
import { formatDate } from '../../lib/dates';

interface Props {
  reviewer: Author;
  date?: Date;
}
const { reviewer, date } = Astro.props;
---

<p class="max-w-xl text-center text-xs text-muted">
  Revisado por <a class="link font-semibold text-ink" href={authorUrl(reviewer.id)}>{reviewer.data.name}</a
  >{reviewer.data.credentials && <>, {reviewer.data.credentials}</>}{
    date && (
      <>
        , el <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </>
    )
  }
</p>
