---
import { authorUrl, type Author } from '../../lib/content';
import { formatDate } from '../../lib/dates';

interface Props {
  reviewer: Author;
  date?: Date;
}
const { reviewer, date } = Astro.props;
---

<p class="reviewed">
  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
    <path
      d="M10 1.5 3 4.2v5c0 4.2 2.9 7.9 7 9.3 4.1-1.4 7-5.1 7-9.3v-5L10 1.5Zm-1.1 11.7L5.8 10l1.2-1.2 1.9 1.9 4.1-4.1 1.2 1.2-5.3 5.4Z"
      fill="currentColor"></path>
  </svg>
  <span>
    Revisado por <a href={authorUrl(reviewer.id)}>{reviewer.data.name}</a>{
      reviewer.data.credentials && <>, {reviewer.data.credentials}</>
    }{date && <>, el {formatDate(date)}</>}
  </span>
</p>

<style>
  .reviewed {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-2);
    padding-block: var(--sp-3);
    border-block: 1px solid var(--c-rule);
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
  }
  .reviewed svg {
    flex: none;
    margin-top: 0.15em;
    color: var(--c-accent);
  }
  .reviewed a {
    font-weight: 700;
    color: var(--c-ink);
    text-decoration: none;
  }
  .reviewed a:hover {
    text-decoration: underline;
  }
</style>
