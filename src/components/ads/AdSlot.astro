---
import { AD_LABEL, adUnitAttributes, resolveAdsMode, type AdPlacement } from '../../lib/ads';

interface Props {
  placement: AdPlacement;
  class?: string;
}

const { placement, class: className } = Astro.props;
const mode = resolveAdsMode(import.meta.env.DEV, placement);
---

{
  mode !== 'off' && (
    <div class:list={['ad', `ad--${placement}`, className]}>
      <span class="ad__label">{AD_LABEL}</span>
      {mode === 'live' ? (
        <ins class="adsbygoogle" {...adUnitAttributes(placement)} />
      ) : (
        <div class="ad__placeholder">Anuncio · {placement}</div>
      )}
    </div>
  )
}
