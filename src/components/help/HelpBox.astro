---
import PhoneIcon from '../ui/PhoneIcon.astro';
import { EMERGENCY, HELPLINE_LINES } from '../../config/site';

interface Props {
  /** Show the "all resources" link (hidden on /ayuda itself). */
  showMore?: boolean;
  class?: string;
}
const { showMore = true, class: className } = Astro.props;
---

<aside class:list={['border-t-2 border-ink pt-4 pb-2', className]} aria-labelledby="help-title">
  <h2 id="help-title" class="text-xl">Líneas de asistencia</h2>
  <p class="mt-1 text-sm text-muted">Atención gratuita, anónima y confidencial, las 24 horas.</p>
  <ul role="list" class="mt-4 border-t border-rule">
    {
      HELPLINE_LINES.map((l) => (
        <li class="border-b border-rule">
          <a href={l.href} class="group flex min-h-14 items-center gap-4 py-3 no-underline">
            <PhoneIcon class="size-5 flex-none text-accent" />
            <span class="grid">
              <span class="text-xl leading-tight font-semibold text-ink tabular-nums transition-colors group-hover:text-accent">
                {l.number}
              </span>
              <span class="text-xs text-muted">
                {l.name}. {l.detail}.
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-4 text-sm text-ink-2">
    Si hay riesgo inmediato, llamá al{' '}
    <a class="font-semibold text-alert" href={EMERGENCY.href}>{EMERGENCY.number}</a>.
    {
      showMore && (
        <>
          {' '}
          <a class="link-accent" href="/ayuda/">
            Ver todos los recursos
          </a>
        </>
      )
    }
  </p>
</aside>
