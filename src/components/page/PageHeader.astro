---
import Breadcrumbs from '../article/Breadcrumbs.astro';
import type { Crumb } from '../../lib/seo';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, description, crumbs } = Astro.props;
---

<header class="wrap grid justify-items-start gap-3 pt-10 pb-10">
  {crumbs && crumbs.length > 1 && <Breadcrumbs items={crumbs} />}
  {eyebrow && <p class="kicker">{eyebrow}</p>}
  <h1 class="max-w-4xl text-display">{title}</h1>
  {description && <p class="max-w-2xl text-lg leading-normal text-muted">{description}</p>}
  <slot />
</header>
