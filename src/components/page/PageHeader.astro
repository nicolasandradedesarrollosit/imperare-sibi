---
import Breadcrumbs from '../article/Breadcrumbs.astro';
import type { Crumb } from '../../lib/seo';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, description, crumbs } = Astro.props;
---

<header class="wrap grid justify-items-center gap-3 pt-10 pb-10 text-center">
  {crumbs && crumbs.length > 1 && <Breadcrumbs items={crumbs} />}
  {eyebrow && <p class="kicker kicker--block">{eyebrow}</p>}
  <h1 class="text-display tracking-tight">{title}</h1>
  {description && <p class="max-w-2xl font-serif text-lg leading-normal text-ink-2">{description}</p>}
  <slot />
</header>
