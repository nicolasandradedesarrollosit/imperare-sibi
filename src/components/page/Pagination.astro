---
interface Props {
  prev?: string | undefined;
  next?: string | undefined;
  current: number;
  last: number;
}
const { prev, next, current, last } = Astro.props;
---

{
  last > 1 && (
    <nav class="pager" aria-label="Paginación">
      {prev ? (
        <a href={prev} rel="prev">
          ← Más recientes
        </a>
      ) : (
        <span />
      )}
      <span class="pager__n">
        Página {current} de {last}
      </span>
      {next ? (
        <a href={next} rel="next">
          Anteriores →
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: var(--sp-8);
    padding-block: var(--sp-4);
    border-top: 1px solid var(--c-ink);
    font-size: var(--fs-sm);
  }
  .pager a {
    font-weight: 700;
    text-decoration: none;
  }
  .pager a:last-child {
    text-align: right;
  }
  .pager__n {
    color: var(--c-muted);
  }
</style>
