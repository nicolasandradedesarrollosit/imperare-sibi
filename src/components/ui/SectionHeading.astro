---
/** Block heading: hairline rule on top, title on the left, optional link on the right. */
interface Props {
  id: string;
  title: string;
  more?: { href: string; label: string };
  as?: 'h2' | 'h3';
}
const { id, title, more, as: Tag = 'h2' } = Astro.props;
---

<div class="heading">
  <Tag id={id} class="heading__title">{title}</Tag>
  {more && <a class="heading__more" href={more.href}>{more.label}</a>}
</div>
