---
import SectionHeading from '../ui/SectionHeading.astro';
import { SECTIONS } from '../../config/site';
import { bySection, sectionUrl, type Article } from '../../lib/content';

/**
 * Typographic index of every category: name, description and article count,
 * in two ruled columns. Always lists every category, whatever the content volume.
 */
interface Props {
  articles: Article[];
}
const { articles } = Astro.props;
const categories = SECTIONS.map((section) => ({ section, count: bySection(articles, section.slug).length }));
---

<section class="wrap section" aria-labelledby="categories-title">
  <SectionHeading id="categories-title" title="Categorías" />
  <ul role="list" class="grid gap-x-(--col-gap) sm:grid-cols-2">
    {
      categories.map(({ section, count }) => (
        <li class="border-b border-rule py-4">
          <a href={sectionUrl(section.slug)} class="group grid gap-1 no-underline">
            <span class="flex items-baseline justify-between gap-4">
              <span class="text-lg font-semibold transition-colors group-hover:text-accent">
                {section.name}
              </span>
              <span class="text-xs text-muted tabular-nums">
                {count} {count === 1 ? 'nota' : 'notas'}
              </span>
            </span>
            <span class="text-sm text-muted">{section.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
