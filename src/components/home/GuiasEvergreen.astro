---
import type { Articulo } from '../../lib/content';
import { articuloUrl } from '../../lib/content';
import { getSeccion } from '../../config/site';

interface Props {
  guias: Articulo[];
}
const { guias } = Astro.props;
---

{
  guias.length > 0 && (
    <section class="guias" aria-labelledby="guias-title">
      <div class="container">
        <div class="guias__head">
          <p class="kicker">Para entender</p>
          <h2 id="guias-title">Guías esenciales</h2>
          <p>Explicaciones claras y revisadas por profesionales sobre los temas que más nos consultan.</p>
        </div>
        <ol role="list" class="guias__list">
          {guias.map((g, i) => (
            <li>
              <span class="guias__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <p class="guias__sec">{getSeccion(g.data.seccion)?.nombre}</p>
                <h3>
                  <a href={articuloUrl(g)}>{g.data.title}</a>
                </h3>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .guias {
    background: var(--c-sage-tint);
    padding-block: var(--sp-7);
  }
  .guias__head {
    display: grid;
    gap: var(--sp-2);
    max-width: 36rem;
    margin-bottom: var(--sp-6);
  }
  .guias__head h2 {
    font-size: var(--fs-2xl);
  }
  .guias__head p:last-child {
    color: var(--c-ink-soft);
  }
  .guias__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--sp-5) var(--sp-6);
  }
  .guias__list li {
    display: flex;
    gap: var(--sp-4);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--c-line-strong);
  }
  .guias__n {
    font-family: var(--f-serif);
    font-size: var(--fs-2xl);
    font-style: italic;
    line-height: 1;
    color: var(--c-sage);
  }
  .guias__sec {
    font-size: var(--fs-xs);
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  .guias h3 {
    font-size: var(--fs-md);
    line-height: var(--lh-snug);
  }
  .guias h3 a {
    text-decoration: none;
  }
  .guias h3 a:hover {
    text-decoration: underline;
  }
</style>
