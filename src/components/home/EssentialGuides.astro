---
import ArticleCard from '../article/ArticleCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { Article } from '../../lib/content';

interface Props {
  guides: Article[];
}
const { guides } = Astro.props;
---

{
  guides.length > 0 && (
    <section class="bg-paper-alt py-16" aria-labelledby="guides-title">
      <div class="wrap">
        <SectionHeading
          id="guides-title"
          title="Guías esenciales"
          intro="Explicaciones claras, revisadas por profesionales, sobre los temas que más nos consultan."
        />
        <div class="ruled ruled--2 max-sm:[&>*+*]:border-t max-sm:[&>*+*]:border-rule max-sm:[&>*+*]:pt-6">
          {guides.map((g) => (
            <ArticleCard article={g} variant="row" />
          ))}
        </div>
      </div>
    </section>
  )
}
