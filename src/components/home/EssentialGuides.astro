---
import ArticleCard from '../article/ArticleCard.astro';
import type { Article } from '../../lib/content';
interface Props {
  guides: Article[];
}
const { guides } = Astro.props;
---

{
  guides.length > 0 && (
    <section class="guides" aria-labelledby="guides-title">
      <div class="wrap">
        <div class="rubric">
          <h2 id="guides-title" class="rubric__title">
            Guías esenciales
          </h2>
          <p class="guides__intro">Explicaciones claras, revisadas por profesionales.</p>
        </div>
        <div class="ruled ruled--3">
          {guides.map((g) => (
            <ArticleCard article={g} variant="row" />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .guides {
    padding-block: var(--sp-6) var(--sp-7);
    background: var(--c-bg-alt);
  }
  .guides__intro {
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }
  @media (max-width: 40rem) {
    .guides__intro {
      display: none;
    }
    .guides .ruled > * + * {
      padding-top: var(--sp-4);
      border-top: 1px solid var(--c-rule);
    }
    .guides .ruled {
      row-gap: var(--sp-4);
    }
  }
</style>
