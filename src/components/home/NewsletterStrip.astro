---
import { SITE } from '../../config/site';
const enabled = SITE.newsletterAction.length > 0;
---

<section id="newsletter" class="wrap" aria-labelledby="newsletter-title">
  <div class="mx-auto max-w-2xl border-y border-ink py-12 text-center">
    <h2 id="newsletter-title" class="text-title">Un respiro semanal en tu correo</h2>
    <p class="mt-3 text-ink-2">Cada domingo: las notas de la semana, una guía práctica y recursos para cuidarte. Sin spam.</p>
    <form
      class="mx-auto mt-6 flex max-w-md flex-col gap-2 sm:flex-row"
      method="post"
      action={enabled ? SITE.newsletterAction : undefined}
    >
      <label for="newsletter-email" class="sr-only">Correo electrónico</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        required
        placeholder="tu@correo.com"
        autocomplete="email"
        disabled={!enabled}
        class="min-w-0 flex-1 rounded-full border border-rule bg-paper px-5 py-2.5 text-ink disabled:bg-paper-alt"
      />
      <button class="btn" type="submit" disabled={!enabled}>{enabled ? 'Suscribirme' : 'Muy pronto'}</button>
    </form>
  </div>
</section>
