---
import { SITE } from '../../config/site';

/** Rendered only once a newsletter provider is configured (SITE.newsletterAction). */
const enabled = SITE.newsletterAction.length > 0;
---

{
  enabled && (
    <section id="newsletter" class="wrap section" aria-labelledby="newsletter-title">
      <div class="max-w-2xl border-t-2 border-ink pt-4">
        <h2 id="newsletter-title" class="text-xl">
          Newsletter
        </h2>
        <p class="mt-1 text-sm text-muted">Las notas de la semana, cada domingo en tu correo.</p>
        <form class="mt-5 flex max-w-md flex-col gap-2 sm:flex-row" method="post" action={SITE.newsletterAction}>
          <label for="newsletter-email" class="sr-only">
            Correo electrónico
          </label>
          <input
            id="newsletter-email"
            type="email"
            name="email"
            required
            placeholder="tu@correo.com"
            autocomplete="email"
            class="min-w-0 flex-1 rounded-sm border border-muted bg-paper px-4 py-2.5 text-ink"
          />
          <button class="btn" type="submit">
            Suscribirme
          </button>
        </form>
      </div>
    </section>
  )
}
