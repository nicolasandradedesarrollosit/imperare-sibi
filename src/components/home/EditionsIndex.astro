---
import { PROVINCES } from '../../config/site';
import { provinceUrl } from '../../lib/content';

const regions = [...new Set(PROVINCES.map((p) => p.region))].map((region) => ({
  region,
  provinces: PROVINCES.filter((p) => p.region === region),
}));
---

<section class="wrap editions-index" aria-labelledby="editions-title">
  <div class="rubric">
    <h2 id="editions-title" class="rubric__title">Ediciones provinciales</h2>
    <p class="editions-index__intro">Noticias y recursos cerca tuyo. Sumamos provincias a la red.</p>
  </div>
  <div class="ruled editions-index__grid">
    {
      regions.map(({ region, provinces }) => (
        <div>
          <h3 class="label">{region}</h3>
          <ul role="list">
            {provinces.map((p) => (
              <li>{p.active ? <a href={provinceUrl(p.slug)}>{p.name}</a> : <span>{p.name}</span>}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .editions-index__intro {
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }
  .editions-index__grid {
    --cols: 5;
  }
  .editions-index h3 {
    margin-bottom: var(--sp-2);
  }
  .editions-index ul {
    display: grid;
    gap: var(--sp-1);
    font-size: var(--fs-sm);
  }
  .editions-index a {
    font-weight: 700;
    color: var(--c-accent-dark);
    text-decoration: none;
  }
  .editions-index a:hover {
    text-decoration: underline;
  }
  .editions-index span {
    color: var(--c-muted);
  }
  @media (max-width: 64rem) {
    .editions-index__grid {
      --cols: 3;
    }
  }
  @media (max-width: 40rem) {
    .editions-index__grid {
      --cols: 2;
    }
    .editions-index__intro {
      display: none;
    }
  }
</style>
