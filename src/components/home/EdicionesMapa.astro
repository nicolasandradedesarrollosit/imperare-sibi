---
import { PROVINCIAS } from '../../config/site';

const regiones = [...new Set(PROVINCIAS.map((p) => p.region))].map((region) => ({
  region,
  provincias: PROVINCIAS.filter((p) => p.region === region),
}));
---

<section class="container ediciones" aria-labelledby="ediciones-title">
  <div class="section-title">
    <h2 id="ediciones-title">Ediciones provinciales</h2>
  </div>
  <p class="ediciones__intro">
    Noticias, recursos y profesionales cerca tuyo. Estamos sumando nuevas provincias a la red.
  </p>
  <div class="ediciones__grid">
    {
      regiones.map(({ region, provincias }) => (
        <div>
          <h3>{region}</h3>
          <ul role="list">
            {provincias.map((p) => (
              <li>
                {p.activa ? (
                  <a href={`/edicion/${p.slug}/`}>{p.nombre}</a>
                ) : (
                  <span>
                    {p.nombre} <small>Próximamente</small>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .ediciones__intro {
    color: var(--c-ink-soft);
    margin-bottom: var(--sp-5);
  }
  .ediciones__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--sp-5);
  }
  .ediciones h3 {
    font-family: var(--f-sans);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-muted);
    margin-bottom: var(--sp-2);
  }
  .ediciones ul {
    display: grid;
    gap: var(--sp-1);
    font-size: var(--fs-sm);
  }
  .ediciones a {
    font-weight: 600;
    color: var(--c-sage-strong);
    text-decoration: none;
  }
  .ediciones a:hover {
    text-decoration: underline;
  }
  .ediciones span {
    color: var(--c-muted);
  }
  .ediciones small {
    font-size: 0.7rem;
    opacity: 0.8;
  }
</style>
