---
import { articleUrl, type Article } from '../../lib/content';
import { formatListingDate } from '../../lib/dates';
interface Props {
  articles: Article[];
}
const { articles } = Astro.props;
---

<section class="latest" aria-labelledby="latest-title">
  <h2 id="latest-title" class="label latest__title">Lo último</h2>
  <ol role="list">
    {
      articles.map((a) => (
        <li>
          <time datetime={a.data.publishedAt.toISOString()}>{formatListingDate(a.data.publishedAt)}</time>
          <a href={articleUrl(a)}>{a.data.title}</a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .latest__title {
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--c-ink);
  }
  .latest li {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: var(--sp-2);
    padding-block: var(--sp-3);
    border-bottom: 1px solid var(--c-rule);
  }
  .latest time {
    padding-top: 0.2em;
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--c-accent);
  }
  .latest a {
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    font-weight: 600;
    line-height: var(--lh-snug);
    text-decoration: none;
  }
  .latest a:hover {
    text-decoration: underline;
  }
</style>
