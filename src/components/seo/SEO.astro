---
import { SITE } from '../../config/site';
import { absUrl } from '../../lib/seo';

export interface SeoProps {
  title: string;
  description: string;
  /** Path or absolute URL of the social image. */
  image?: { url: string; width: number; height: number; alt?: string };
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  author?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    section: string;
    tags: string[];
    authorUrl?: string;
  };
  /** Pagination links. */
  prev?: string | undefined;
  next?: string | undefined;
}

const {
  title,
  description,
  image = { url: SITE.defaultOgImage, width: 1200, height: 630, alt: SITE.name },
  canonical,
  type = 'website',
  noindex = false,
  author,
  article,
  prev,
  next,
} = Astro.props as SeoProps;

// Brand suffix only when the whole title still fits Google's ~60-character display.
const TITLE_MAX = 60;
const branded = `${title} | ${SITE.name}`;
const fullTitle =
  title === SITE.name ? `${SITE.name}: salud mental en Argentina` : branded.length <= TITLE_MAX ? branded : title;
const canonicalUrl = canonical ?? absUrl(Astro.url.pathname);
const imageUrl = absUrl(image.url);
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robots} />
{author && <meta name="author" content={author} />}
{prev && <link rel="prev" href={absUrl(prev)} />}
{next && <link rel="next" href={absUrl(next)} />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />
<meta property="og:image:alt" content={image.alt ?? title} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
      <meta property="article:section" content={article.section} />
      {article.authorUrl && <meta property="article:author" content={absUrl(article.authorUrl)} />}
      {article.tags.map((t) => (
        <meta property="article:tag" content={t} />
      ))}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitterHandle} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={image.alt ?? title} />
