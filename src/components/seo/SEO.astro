---
import { SITE } from '../../config/site';
import { absUrl } from '../../lib/seo';

export interface SeoProps {
  title: string;
  description: string;
  /** Ruta o URL absoluta de la imagen para redes. */
  image?: string;
  imageAlt?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    section: string;
    tags: string[];
    authorUrl?: string;
  };
  /** URLs de paginación (rel prev/next). */
  prev?: string;
  next?: string;
}

const {
  title,
  description,
  image = SITE.defaultOgImage,
  imageAlt = SITE.name,
  canonical,
  type = 'website',
  noindex = false,
  article,
  prev,
  next,
} = Astro.props as SeoProps;

const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
const imageUrl = absUrl(image);
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robots} />
<link rel="alternate" hreflang="es-AR" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
{prev && <link rel="prev" href={absUrl(prev)} />}
{next && <link rel="next" href={absUrl(next)} />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="es_AR" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      {article.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
      )}
      <meta property="article:section" content={article.section} />
      {article.authorUrl && <meta property="article:author" content={absUrl(article.authorUrl)} />}
      {article.tags.map((t) => (
        <meta property="article:tag" content={t} />
      ))}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitterHandle} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
