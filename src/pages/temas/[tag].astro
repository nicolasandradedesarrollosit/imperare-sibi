---
import type { GetStaticPaths } from 'astro';
import ListingLayout from '../../layouts/ListingLayout.astro';
import { SITE } from '../../config/site';
import { collectTags, getArticles, MIN_ARTICLES_TO_INDEX_TAG, tagUrl, type Tag } from '../../lib/content';
import { crumbs } from '../../lib/seo';

export const getStaticPaths = (async () =>
  collectTags(await getArticles()).map((tag) => ({ params: { tag: tag.slug }, props: { tag } }))) satisfies GetStaticPaths;

interface Props {
  tag: Tag;
}
const { tag } = Astro.props;
const path = tagUrl(tag.name);
---

<ListingLayout
  title={`${tag.name}: todas las notas del tema`}
  heading={tag.name}
  eyebrow="Tema"
  description={`Todo sobre ${tag.name.toLowerCase()} en ${SITE.name}: guías, noticias y experiencias sobre salud mental en la Argentina.`}
  path={path}
  crumbs={crumbs({ name: 'Temas', href: '/temas/' }, { name: tag.name, href: path })}
  articles={tag.articles}
  withLead={false}
  showDescription={false}
  showCrumbs
  noindex={tag.articles.length < MIN_ARTICLES_TO_INDEX_TAG}
/>
