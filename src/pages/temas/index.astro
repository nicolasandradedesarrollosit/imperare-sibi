---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import { SITE } from '../../config/site';
import { collectTags, getArticles, tagUrl } from '../../lib/content';
import { breadcrumbLd, crumbs } from '../../lib/seo';

const tags = collectTags(await getArticles());
const description = `Índice de todos los temas de ${SITE.name}: ansiedad, depresión, vínculos, sueño, derechos y más, con las guías y notas de cada uno.`;

---

<BaseLayout seo={{ title: 'Temas', description }} jsonLd={[breadcrumbLd(crumbs({ name: 'Temas', href: '/temas/' }))]}>
  <PageHeader eyebrow="Índice" title="Temas" description={description} />
  <div class="wrap">
    <ul role="list" class="mx-auto flex max-w-3xl flex-wrap justify-center gap-3">
      {
        tags.map((t) => (
          <li>
            <a
              href={tagUrl(t.name)}
              class="chip items-baseline gap-2 px-4 py-2"
            >
              <span class="font-serif text-lg font-semibold">{t.name}</span>
              <span class="text-xs text-muted">{t.articles.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
