---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import { SITE } from '../../config/site';
import { collectTags, getArticles, tagUrl } from '../../lib/content';
import { breadcrumbLd, crumbs } from '../../lib/seo';

const tags = collectTags(await getArticles());
const description = `Índice de todos los temas de ${SITE.name}: ansiedad, depresión, vínculos, sueño, derechos y más, con las guías y notas de cada uno.`;

---

<BaseLayout page="listing" seo={{ title: 'Temas', description }} jsonLd={[breadcrumbLd(crumbs({ name: 'Temas', href: '/temas/' }))]}>
  <PageHeader eyebrow="Índice" title="Temas" description={description} />
  <div class="wrap">
    <ul role="list" class="mx-auto max-w-4xl gap-x-(--col-gap) sm:columns-2 lg:columns-3">
      {
        tags.map((t) => (
          <li class="break-inside-avoid border-b border-rule">
            <a href={tagUrl(t.name)} class="group flex items-baseline justify-between gap-4 py-3 no-underline">
              <span class="font-serif text-lg font-semibold transition-colors group-hover:text-accent-dark">{t.name}</span>
              <span class="text-xs text-muted tabular-nums">{t.articles.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
