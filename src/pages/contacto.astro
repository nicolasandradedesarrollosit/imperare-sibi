---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../config/site';
---

<PageLayout
  eyebrow="El blog"
  title="Contacto"
  description="Escribinos para proponer temas, reportar correcciones, contar tu experiencia o sumarte como profesional revisor de las notas del blog."
>
  <p>Redacción: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  <p>
    Este no es un canal de atención en salud mental. Si estás atravesando una crisis, visitá nuestra página de <a
      href="/ayuda/">recursos de ayuda</a
    >.
  </p>
</PageLayout>
