---
import type { GetStaticPaths, Page } from 'astro';
import ListingLayout from '../../layouts/ListingLayout.astro';
import { SITE } from '../../config/site';
import { archiveUrl, getArticles, type Article } from '../../lib/content';
import { crumbs } from '../../lib/seo';

/** Archive of every article, newest first. */
export const getStaticPaths = (async ({ paginate }) =>
  paginate(await getArticles(), { pageSize: SITE.pageSize })) satisfies GetStaticPaths;

interface Props {
  page: Page<Article>;
}
const { page } = Astro.props;
const isFirst = page.currentPage === 1;
---

<ListingLayout
  title={isFirst ? 'Todas las notas' : `Todas las notas, página ${page.currentPage}`}
  heading="Todas las notas"
  eyebrow="Archivo"
  description={`Archivo completo de ${SITE.name}: guías, experiencias y novedades sobre salud mental, de la más reciente a la más antigua.`}
  path={page.url.current}
  crumbs={crumbs({ name: 'Todas las notas', href: archiveUrl })}
  articles={page.data}
  withLead={isFirst}
  pagination={{ prev: page.url.prev, next: page.url.next, current: page.currentPage, last: page.lastPage }}
/>
