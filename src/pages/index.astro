---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/article/ArticleCard.astro';
import FrontPage from '../components/home/FrontPage.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import EssentialGuides from '../components/home/EssentialGuides.astro';
import CategoryGrid from '../components/home/CategoryGrid.astro';
import NewsletterStrip from '../components/home/NewsletterStrip.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import { SITE } from '../config/site';
import { archiveUrl, getArticles, take } from '../lib/content';

const articles = await getArticles();
const used = new Set<string>();
// Lead: the newest `featured` article (or simply the newest). Secondary: other
// featured pieces first, then the latest ones.
const [lead] = take(articles, used, 1, (a) => a.data.featured).concat(take(articles, used, 1));
const featured = take(articles, used, 2, (a) => a.data.featured);
const secondary = [...featured, ...take(articles, used, 2 - featured.length)];
const latest = take(articles, used, 6);
const guides = articles.filter((a) => a.data.type === 'guide').slice(0, 6);
---

<BaseLayout seo={{ title: SITE.name, description: SITE.description }}>
  <h1 class="sr-only">{SITE.name}: {SITE.tagline}</h1>

  {lead && <FrontPage lead={lead} secondary={secondary} />}

  {
    latest.length > 0 && (
      <section class="wrap pt-14" aria-labelledby="latest-title">
        <SectionHeading id="latest-title" title="Últimas notas" more={{ href: archiveUrl, label: 'Ver todas las notas' }} />
        <div class="ruled">
          {latest.map((a) => (
            <ArticleCard article={a} variant="stack" showDek />
          ))}
        </div>
      </section>
    )
  }

  <div class="wrap"><AdSlot placement="horizontal" class="my-14" /></div>

  <EssentialGuides guides={guides} />

  <div class="py-16">
    <CategoryGrid articles={articles} />
  </div>

  <NewsletterStrip />
</BaseLayout>
