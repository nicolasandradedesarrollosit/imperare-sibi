---
import type { GetStaticPaths, Page } from 'astro';
import ListingLayout from '../../layouts/ListingLayout.astro';
import { SECTIONS, SITE, type Section } from '../../config/site';
import { bySection, getArticles, sectionUrl, type Article } from '../../lib/content';
import { crumbs } from '../../lib/seo';

export const getStaticPaths = (async ({ paginate }) => {
  const articles = await getArticles();
  return SECTIONS.flatMap((section) =>
    paginate(bySection(articles, section.slug), {
      params: { seccion: section.slug },
      props: { section },
      pageSize: SITE.pageSize,
    }),
  );
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Article>;
  section: Section;
}
const { page, section } = Astro.props;
const isFirst = page.currentPage === 1;
---

<ListingLayout
  title={isFirst ? `${section.name}: guías y notas` : `${section.name}, página ${page.currentPage}`}
  heading={section.name}
  eyebrow="Categoría"
  description={section.description}
  path={page.url.current}
  crumbs={crumbs({ name: section.name, href: sectionUrl(section.slug) })}
  articles={page.data}
  section={section}
  withLead={isFirst}
  showSection={false}
  pagination={{ prev: page.url.prev, next: page.url.next, current: page.currentPage, last: page.lastPage }}
/>
