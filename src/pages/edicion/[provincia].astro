---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import { ACTIVE_PROVINCES, HELPLINES, type Province } from '../../config/site';
import { byProvince, getArticles, provinceUrl } from '../../lib/content';
import { breadcrumbLd, collectionLd } from '../../lib/seo';

export const getStaticPaths = (() =>
  ACTIVE_PROVINCES.map((province) => ({
    params: { provincia: province.slug },
    props: { province },
  }))) satisfies GetStaticPaths;

interface Props {
  province: Province;
}
const { province } = Astro.props;
const all = await getArticles();
const local = byProvince(all, province.slug);
const national = all.filter((a) => !a.data.province).slice(0, 4);
const path = provinceUrl(province.slug);
const title = `Salud mental en ${province.name}`;
const description = `Noticias, recursos de ayuda y guías sobre salud mental en ${province.name}. Edición provincial de Imperare Sibi.`;
const crumbs = [
  { name: 'Portada', href: '/' },
  { name: `Edición ${province.name}`, href: path },
];
---

<BaseLayout
  seo={{
    title,
    description,
    // No local stories yet = thin content: keep it out of the index until there are.
    noindex: local.length === 0,
  }}
  jsonLd={[breadcrumbLd(crumbs), collectionLd({ name: title, description, path, articles: local })]}
>
  <PageHeader eyebrow={`Edición ${province.region}`} title={title} description={description} />
  <div class="wrap edition">
    <section class="edition__local" aria-labelledby="local-title">
      <div class="rubric">
        <h2 id="local-title" class="rubric__title">Noticias de {province.name}</h2>
      </div>
      {
        local.length === 1 ? (
          <ArticleCard article={local[0]!} variant="wide" />
        ) : local.length > 1 ? (
          <div class="ruled ruled--2">
            {local.map((a) => (
              <ArticleCard article={a} variant="stack" showDek />
            ))}
          </div>
        ) : (
          <p class="empty">Estamos preparando la cobertura local de {province.name}.</p>
        )
      }
    </section>

    <aside class="edition__help" aria-labelledby="help-title">
      <h2 id="help-title" class="label">Dónde pedir ayuda</h2>
      <ul role="list">
        {
          HELPLINES.map((l) => (
            <li>
              <a href={`tel:${l.tel}`}>{l.number}</a>
              <span>{l.name}</span>
            </li>
          ))
        }
      </ul>
      <p>Muy pronto: directorio de profesionales y centros de salud mental en {province.name}.</p>
    </aside>

    <section class="edition__national" aria-labelledby="national-title">
      <div class="rubric">
        <h2 id="national-title" class="rubric__title">Lo último en el país</h2>
        <a class="rubric__more" href="/">Edición nacional</a>
      </div>
      <div class="ruled compact-mobile">
        {national.map((a) => <ArticleCard article={a} variant="stack" />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .edition {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--w-rail);
    gap: var(--sp-8) var(--sp-8);
  }
  .edition__national {
    grid-column: 1 / -1;
  }
  .edition__help {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
    padding-top: var(--sp-2);
    border-top: 3px solid var(--c-accent);
    font-size: var(--fs-sm);
  }
  .edition__help ul {
    display: grid;
  }
  .edition__help li {
    display: grid;
    padding-block: var(--sp-2);
    border-bottom: 1px solid var(--c-rule);
  }
  .edition__help a {
    font-weight: 700;
    font-size: var(--fs-md);
    color: var(--c-accent-dark);
    text-decoration: none;
  }
  .edition__help span,
  .edition__help p,
  .empty {
    color: var(--c-muted);
  }
  @media (max-width: 64rem) {
    .edition {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
