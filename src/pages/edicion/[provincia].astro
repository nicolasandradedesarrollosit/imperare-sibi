---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import { LINEAS_AYUDA, PROVINCIAS } from '../../config/site';
import { getArticulos, porProvincia } from '../../lib/content';
import { breadcrumbLd } from '../../lib/seo';

export const getStaticPaths = (() =>
  PROVINCIAS.filter((p) => p.activa).map((provincia) => ({
    params: { provincia: provincia.slug },
    props: { provincia },
  }))) satisfies GetStaticPaths;

interface Props {
  provincia: (typeof PROVINCIAS)[number];
}
const { provincia } = Astro.props;
const todos = await getArticulos();
const locales = porProvincia(todos, provincia.slug);
const nacionales = todos.filter((a) => !a.data.provincia).slice(0, 6);
const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: `Edición ${provincia.nombre}`, href: `/edicion/${provincia.slug}/` },
];
---

<BaseLayout
  seo={{
    title: `Salud mental en ${provincia.nombre}`,
    description: `Noticias, recursos de ayuda y guías sobre salud mental en ${provincia.nombre}. Edición provincial de Imperare Sibi.`,
    // Sin notas locales la página es "thin content": no indexar hasta tener contenido propio.
    noindex: locales.length === 0,
  }}
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <PageHeader
    kicker={`Edición ${provincia.region}`}
    title={`Salud mental en ${provincia.nombre}`}
    description={`Noticias locales, recursos y profesionales de ${provincia.nombre}.`}
    crumbs={crumbs}
  />
  <div class="container edicion">
    <section aria-labelledby="locales">
      <div class="section-title"><h2 id="locales">Noticias de {provincia.nombre}</h2></div>
      {
        locales.length > 0 ? (
          <div class="grid">
            {locales.map((a) => (
              <ArticleCard articulo={a} variant="medium" as="h3" />
            ))}
          </div>
        ) : (
          <p class="vacio">Estamos preparando la cobertura local de {provincia.nombre}.</p>
        )
      }
    </section>

    <aside class="recursos" aria-labelledby="recursos">
      <h2 id="recursos">Dónde pedir ayuda</h2>
      <ul role="list">
        {
          LINEAS_AYUDA.map((l) => (
            <li>
              <a href={`tel:${l.tel}`}>{l.numero}</a> <span>{l.nombre}</span>
            </li>
          ))
        }
      </ul>
      <p>Próximamente: directorio de profesionales y centros de salud mental en {provincia.nombre}.</p>
    </aside>

    <section aria-labelledby="nacional" class="nacional">
      <div class="section-title">
        <h2 id="nacional">Lo último en el país</h2><a href="/">Ir a la edición nacional</a>
      </div>
      <div class="grid">
        {nacionales.map((a) => <ArticleCard articulo={a} variant="medium" as="h3" />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .edicion {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: var(--sp-7);
  }
  .nacional {
    grid-column: 1 / -1;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--sp-6);
  }
  .recursos {
    align-self: start;
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-5);
    background: var(--c-sage-tint);
    border-radius: var(--radius);
    font-size: var(--fs-sm);
  }
  .recursos h2 {
    font-size: var(--fs-lg);
  }
  .recursos ul {
    display: grid;
    gap: var(--sp-2);
  }
  .recursos li {
    display: grid;
  }
  .recursos a {
    font-weight: 700;
    color: var(--c-sage-strong);
  }
  .recursos span,
  .vacio {
    color: var(--c-muted);
  }
  @media (max-width: 56rem) {
    .edicion {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
