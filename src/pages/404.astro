---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTIONS } from '../config/site';
import { sectionUrl } from '../lib/content';
---

<BaseLayout seo={{ title: 'Página no encontrada', description: 'La página que buscás no existe o fue movida.', noindex: true }} page="error">
  <section class="wrap grid justify-items-start gap-5 py-20">
    <p class="label text-muted">Error 404</p>
    <h1 class="text-display">Página no encontrada</h1>
    <p class="max-w-xl text-ink-2">La dirección no existe o fue modificada. Podés consultar las siguientes categorías:</p>
    <ul role="list" class="flex flex-wrap gap-x-5 gap-y-2">
      {
        SECTIONS.map((s) => (
          <li>
            <a class="link-accent" href={sectionUrl(s.slug)}>
              {s.name}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn mt-4" href="/">Volver al inicio</a>
  </section>
</BaseLayout>
