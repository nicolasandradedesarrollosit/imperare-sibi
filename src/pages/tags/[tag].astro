---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import { SITE } from '../../config/site';
import { getArticulos, slugify, type Articulo } from '../../lib/content';

export const getStaticPaths = (async () => {
  const articulos = await getArticulos();
  const tags = new Map<string, { nombre: string; articulos: Articulo[] }>();
  for (const a of articulos) {
    for (const t of a.data.tags) {
      const slug = slugify(t);
      const entry = tags.get(slug) ?? { nombre: t, articulos: [] };
      entry.articulos.push(a);
      tags.set(slug, entry);
    }
  }
  return [...tags].map(([tag, { nombre, articulos }]) => ({ params: { tag }, props: { nombre, articulos } }));
}) satisfies GetStaticPaths;

interface Props {
  nombre: string;
  articulos: Articulo[];
}
const { nombre, articulos } = Astro.props;
// Las páginas de tag con poco contenido no se indexan (evita "thin content").
const noindex = articulos.length < 3;
---

<BaseLayout
  seo={{
    title: `${nombre}: notas y guías`,
    description: `Todas las notas de ${SITE.name} sobre ${nombre.toLowerCase()}: guías, noticias y entrevistas revisadas por profesionales.`,
    noindex,
  }}
>
  <PageHeader
    kicker="Tema"
    title={nombre}
    crumbs={[
      { name: 'Inicio', href: '/' },
      { name: nombre, href: Astro.url.pathname },
    ]}
  />
  <div class="container lista">
    {articulos.map((a) => <ArticleCard articulo={a} variant="list" as="h2" />)}
  </div>
</BaseLayout>

<style>
  .lista {
    max-width: 52rem;
  }
</style>
