---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import { authorUrl, getArticles, type Author } from '../../lib/content';
import { breadcrumbLd, profilePageLd } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const authors = await getCollection('authors');
  return authors.map((author) => ({ params: { autor: author.id }, props: { author } }));
}) satisfies GetStaticPaths;

interface Props {
  author: Author;
}
const { author } = Astro.props;
const all = await getArticles();
const written = all.filter((a) => a.data.author.id === author.id);
const reviewed = all.filter((a) => a.data.reviewer?.id === author.id);
const path = authorUrl(author.id);
const crumbs = [
  { name: 'Portada', href: '/' },
  { name: author.data.name, href: path },
];
const social = Object.entries(author.data.social).filter(([, url]) => url) as [string, string][];
---

<BaseLayout
  seo={{ title: `${author.data.name}, ${author.data.role}`, description: author.data.bio.slice(0, 160), type: 'profile' }}
  jsonLd={[profilePageLd(author, path), breadcrumbLd(crumbs)]}
  ads={false}
>
  <PageHeader eyebrow={author.data.role} title={author.data.name} description={author.data.bio}>
    {author.data.photo && <Image src={author.data.photo} alt={author.data.name} width={96} height={96} class="photo" />}
    {author.data.credentials && <p class="credentials">{author.data.credentials}</p>}
    {
      social.length > 0 && (
        <ul role="list" class="social">
          {social.map(([network, url]) => (
            <li>
              <a href={url} rel="me noopener">
                {network}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </PageHeader>
  <div class="wrap lists">
    {
      written.length > 0 && (
        <section aria-labelledby="written">
          <div class="rubric">
            <h2 id="written" class="rubric__title">
              Notas
            </h2>
          </div>
          <div class="stacked">
            {written.map((a) => (
              <ArticleCard article={a} variant="row" showDek />
            ))}
          </div>
        </section>
      )
    }
    {
      reviewed.length > 0 && (
        <section aria-labelledby="reviewed">
          <div class="rubric">
            <h2 id="reviewed" class="rubric__title">
              Notas revisadas
            </h2>
          </div>
          <div class="stacked">
            {reviewed.map((a) => (
              <ArticleCard article={a} variant="row" showDek />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .photo {
    border-radius: 50%;
  }
  .credentials {
    font-weight: 700;
    color: var(--c-accent-dark);
  }
  .social {
    display: flex;
    gap: var(--sp-4);
    font-size: var(--fs-sm);
    text-transform: capitalize;
  }
  .lists {
    display: grid;
    gap: var(--sp-8);
    max-width: calc(48rem + 2 * var(--gutter));
    margin-inline: 0;
  }
</style>
