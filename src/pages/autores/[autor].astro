---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { authorUrl, getArticles, type Author } from '../../lib/content';
import { breadcrumbLd, crumbs, profilePageLd } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const authors = await getCollection('authors');
  return authors.map((author) => ({ params: { autor: author.id }, props: { author } }));
}) satisfies GetStaticPaths;

interface Props {
  author: Author;
}
const { author } = Astro.props;
const all = await getArticles();
const lists = [
  { id: 'written', title: 'Notas', articles: all.filter((a) => a.data.author.id === author.id) },
  { id: 'reviewed', title: 'Notas revisadas', articles: all.filter((a) => a.data.reviewer?.id === author.id) },
].filter((l) => l.articles.length > 0);
const path = authorUrl(author.id);

const social = Object.entries(author.data.social).filter(([, url]) => url) as [string, string][];
---

<BaseLayout
  seo={{ title: `${author.data.name}, ${author.data.role}`, description: author.data.bio.slice(0, 160), type: 'profile' }}
  jsonLd={[profilePageLd(author, path), breadcrumbLd(crumbs({ name: author.data.name, href: path }))]}
  ads={false}
>
  <PageHeader eyebrow={author.data.role} title={author.data.name} description={author.data.bio}>
    {author.data.photo && <Image src={author.data.photo} alt={author.data.name} width={96} height={96} class="rounded-full" />}
    {author.data.credentials && <p class="font-bold text-accent-dark">{author.data.credentials}</p>}
    {
      social.length > 0 && (
        <ul role="list" class="flex gap-4 text-sm capitalize">
          {social.map(([network, url]) => (
            <li>
              <a href={url} rel="me noopener">
                {network}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </PageHeader>
  <div class="wrap grid gap-16">
    {
      lists.map((list) => (
        <section class="mx-auto w-full max-w-3xl" aria-labelledby={list.id}>
          <SectionHeading id={list.id} title={list.title} />
          <div class="stacked">
            {list.articles.map((a) => (
              <ArticleCard article={a} variant="row" showDek />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
