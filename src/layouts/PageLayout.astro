---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/page/PageHeader.astro';
import { breadcrumbLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  kicker?: string;
  noindex?: boolean;
}
const { title, description, kicker, noindex } = Astro.props;
const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: title, href: Astro.url.pathname },
];
---

<BaseLayout seo={{ title, description, noindex }} jsonLd={[breadcrumbLd(crumbs)]}>
  <PageHeader kicker={kicker} title={title} description={description} crumbs={crumbs} />
  <div class="container">
    <div class="prose"><slot /></div>
  </div>
</BaseLayout>
