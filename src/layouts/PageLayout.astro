---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/page/PageHeader.astro';
import { breadcrumbLd, crumbs } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  noindex?: boolean;
  ads?: boolean;
}
const { title, description, eyebrow, noindex, ads = false } = Astro.props;

---

<BaseLayout seo={{ title, description, noindex }} jsonLd={[breadcrumbLd(crumbs({ name: title, href: Astro.url.pathname }))]} ads={ads}>
  <PageHeader eyebrow={eyebrow} title={title} description={description} />
  <div class="wrap">
    <div class="prose mx-auto max-w-read"><slot /></div>
  </div>
</BaseLayout>
