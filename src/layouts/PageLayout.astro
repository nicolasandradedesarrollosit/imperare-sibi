---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/page/PageHeader.astro';
import { breadcrumbLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  noindex?: boolean;
  ads?: boolean;
}
const { title, description, eyebrow, noindex, ads = false } = Astro.props;
const crumbs = [
  { name: 'Portada', href: '/' },
  { name: title, href: Astro.url.pathname },
];
---

<BaseLayout seo={{ title, description, noindex }} jsonLd={[breadcrumbLd(crumbs)]} ads={ads}>
  <PageHeader eyebrow={eyebrow} title={title} description={description} />
  <div class="wrap">
    <div class="prose page-body"><slot /></div>
  </div>
</BaseLayout>

<style>
  .page-body {
    max-width: var(--w-read);
  }
</style>
