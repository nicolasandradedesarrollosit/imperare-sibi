---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ArticleHeader from '../components/article/ArticleHeader.astro';
import ArticleFigure from '../components/article/ArticleFigure.astro';
import TableOfContents from '../components/article/TableOfContents.astro';
import TagLinks from '../components/article/TagLinks.astro';
import ReadMore from '../components/article/ReadMore.astro';
import HelpBox from '../components/help/HelpBox.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import { getSection, SITE } from '../config/site';
import { articlePageKind, pageAllowsAds } from '../lib/ads';
import { articleUrl, getArticles, readMore, sectionUrl, wordCount, type Article } from '../lib/content';
import { ogImage, schemaImages } from '../lib/images';
import { articleLd, breadcrumbLd, crumbs as trail, faqLd } from '../lib/seo';

interface Props {
  article: Article;
  headings: MarkdownHeading[];
}

const { article, headings } = Astro.props;
const { data } = article;
const section = getSection(data.section)!;
if (data.image.width < 1200) throw new Error(`${article.id}: article images must be at least 1200px wide.`);

const page = articlePageKind(data);
const ads = pageAllowsAds(page);
const more = readMore(article, await getArticles());
const og = await ogImage(data.image);
const images = await schemaImages(data.image);
const crumbs = trail(
  { name: section.name, href: sectionUrl(section.slug) },
  { name: data.title, href: articleUrl(article) },
);
---

<BaseLayout
  activeSection={section.slug}
  page={page}
  seo={{
    title: data.seoTitle ?? data.title,
    description: data.description,
    image: { ...og, alt: data.imageAlt },
    canonical: data.canonical,
    noindex: data.noindex,
    type: 'article',
    article: {
      publishedTime: data.publishedAt,
      modifiedTime: data.updatedAt,
      section: section.name,
      tags: data.tags,
    },
  }}
  jsonLd={[
    articleLd({ article, images, sectionName: section.name, words: wordCount(article.body) }),
    breadcrumbLd(crumbs),
    ...(data.faq.length > 0 ? [faqLd(article)] : []),
  ]}
>
  <!-- data-pagefind-body: only article pages are indexed by the on-site search. -->
  <article data-pagefind-body>
    <ArticleHeader article={article} crumbs={crumbs} />
    <ArticleFigure article={article} />

    <!--
      Three equal-sided columns on very wide screens (≥88rem, where a 300px rail fits in
      the margin): the reading column stays exactly centered and the rail (table of
      contents + ad) sits in the right margin. Narrower screens show a single column.
    -->
    <div
      class="mt-10 px-(--gutter) min-[88rem]:grid min-[88rem]:grid-cols-[minmax(0,1fr)_var(--container-read)_minmax(0,1fr)] min-[88rem]:gap-12"
    >
      <div class="mx-auto max-w-read min-[88rem]:col-start-2 min-[88rem]:mx-0">
        <TableOfContents headings={headings} variant="collapsible" class="mb-8 min-[88rem]:hidden" />
        {data.sensitive && <HelpBox class="mb-10" />}

        <div class="prose">
          <slot />
          {
            data.faq.length > 0 && (
              <section aria-labelledby="preguntas-frecuentes">
                <h2 id="preguntas-frecuentes">Preguntas frecuentes</h2>
                {data.faq.map((item) => (
                  <>
                    <h3>{item.question}</h3>
                    <p>{item.answer}</p>
                  </>
                ))}
              </section>
            )
          }
        </div>

        <footer class="mt-12 grid gap-8" data-pagefind-ignore>
          <TagLinks tags={data.tags} />
          <p class="border-t border-rule pt-4 text-xs text-muted">{SITE.disclaimer}</p>
          {!data.sensitive && <HelpBox />}
        </footer>
      </div>

      <aside class="hidden min-[88rem]:col-start-3 min-[88rem]:block" aria-label="Complementos" data-pagefind-ignore>
        <div class="sticky top-16 grid w-(--container-rail) gap-8">
          <TableOfContents headings={headings} variant="rail" />
          {ads && <AdSlot placement="rail" />}
        </div>
      </aside>
    </div>
  </article>

  <ReadMore articles={more} section={section} />
  {
    ads && (
      <div class="wrap">
        <AdSlot placement="horizontal" />
      </div>
    )
  }
</BaseLayout>
