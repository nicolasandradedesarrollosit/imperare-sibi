---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/article/Breadcrumbs.astro';
import Byline from '../components/article/Byline.astro';
import ReviewedBy from '../components/article/ReviewedBy.astro';
import TagLinks from '../components/article/TagLinks.astro';
import HelpBox from '../components/article/HelpBox.astro';
import ArticleCard from '../components/article/ArticleCard.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import { getProvince, getSection, TYPE_LABEL } from '../config/site';
import {
  articleUrl,
  authorUrl,
  bySection,
  getArticles,
  provinceUrl,
  readingTime,
  related,
  sectionUrl,
  take,
  wordCount,
  type Article,
} from '../lib/content';
import { ogImage, schemaImages } from '../lib/images';
import { articleLd, breadcrumbLd } from '../lib/seo';

interface Props {
  article: Article;
  headings: MarkdownHeading[];
}

const { article, headings } = Astro.props;
const { data } = article;
const section = getSection(data.section)!;
const province = data.province ? getProvince(data.province) : undefined;
const author = await getEntry(data.author);
if (!author) throw new Error(`Unknown author in ${article.id}`);
if (data.image.width < 1200) throw new Error(`${article.id}: article images must be at least 1200px wide.`);
const reviewer = data.reviewer ? await getEntry(data.reviewer) : undefined;

const ads = !data.sensitive;
const toc = headings.filter((h) => h.depth === 2);

// "Seguí leyendo": related by tags first, then same section, then latest.
const all = await getArticles();
const used = new Set([article.id]);
const more = [
  ...take(related(article, all, 4), used, 4),
  ...take(bySection(all, data.section), used, 4),
  ...take(all, used, 4),
].slice(0, 4);

const og = await ogImage(data.image);
const images = await schemaImages(data.image);
const crumbs = [
  { name: 'Portada', href: '/' },
  { name: section.name, href: sectionUrl(section.slug) },
  { name: data.title, href: articleUrl(article) },
];
---

<BaseLayout
  activeSection={section.slug}
  ads={ads}
  seo={{
    title: data.seoTitle ?? data.title,
    description: data.description,
    image: { ...og, alt: data.imageAlt },
    canonical: data.canonical,
    noindex: data.noindex,
    type: 'article',
    author: author.data.name,
    article: {
      publishedTime: data.publishedAt,
      modifiedTime: data.updatedAt,
      section: section.name,
      tags: data.tags,
      authorUrl: authorUrl(author.id),
    },
  }}
  jsonLd={[
    articleLd({ article, author, reviewer, images, sectionName: section.name, words: wordCount(article.body) }),
    breadcrumbLd(crumbs),
  ]}
>
  <article class="wrap story" style={`--c-section:${section.color}`}>
    <div class="story__main">
      <header class="story__header">
        <div class="story__eyebrow">
          <Breadcrumbs items={crumbs} />
          {data.type !== 'news' && <span class="story__type">{TYPE_LABEL[data.type]}</span>}
          {province && <a class="story__province" href={provinceUrl(province.slug)}>{province.name}</a>}
        </div>
        <h1>{data.title}</h1>
        <p class="story__dek">{data.description}</p>
        <Byline author={author} publishedAt={data.publishedAt} updatedAt={data.updatedAt} minutes={readingTime(article.body)} />
        {reviewer && <ReviewedBy reviewer={reviewer} date={data.reviewedAt} />}
      </header>

      <figure class="story__figure">
        <Image
          src={data.image}
          alt={data.imageAlt}
          width={1200}
          height={800}
          widths={[480, 800, 1200]}
          sizes="(max-width: 64rem) 100vw, 54rem"
          fit="cover"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          {data.imageAlt}
          {data.imageCredit && <span class="story__credit">{data.imageCredit}</span>}
        </figcaption>
      </figure>

      {
        toc.length > 2 && (
          <details class="story__toc-mobile">
            <summary>En esta nota</summary>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      {data.sensitive && <HelpBox />}

      <div class="prose story__body">
        <slot />
      </div>

      <footer class="story__footer">
        <TagLinks tags={data.tags} />
        {!data.sensitive && <HelpBox />}
      </footer>
    </div>

    <aside class="story__rail" aria-label="Complementos">
      <div class="story__rail-sticky">
        {
          toc.length > 2 && (
            <nav class="story__toc" aria-labelledby="toc-title">
              <h2 id="toc-title" class="label">
                En esta nota
              </h2>
              <ol role="list">
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {ads && <AdSlot placement="rail" />}
      </div>
    </aside>
  </article>

  {
    more.length > 0 && (
      <section class="wrap more" aria-labelledby="more-title">
        <div class="rubric">
          <h2 id="more-title" class="rubric__title">
            Seguí leyendo
          </h2>
          <a class="rubric__more" href={sectionUrl(section.slug)}>
            Más en {section.name}
          </a>
        </div>
        <div class="ruled compact-mobile">
          {more.map((a) => (
            <ArticleCard article={a} variant="stack" />
          ))}
        </div>
      </section>
    )
  }
  {ads && <div class="wrap"><AdSlot placement="horizontal" /></div>}
</BaseLayout>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--w-rail);
    gap: var(--sp-8);
    padding-top: var(--sp-6);
  }
  .story__main {
    min-width: 0;
    max-width: 54rem;
  }
  .story__header {
    display: grid;
    gap: var(--sp-4);
    max-width: 46rem;
    margin-bottom: var(--sp-6);
  }
  .story__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2) var(--sp-4);
    font-size: var(--fs-sm);
  }
  .story__type {
    font-weight: 700;
    color: var(--c-ink);
  }
  .story__province {
    color: var(--c-muted);
    font-weight: 600;
    text-decoration: none;
  }
  .story h1 {
    font-size: var(--fs-3xl);
    letter-spacing: -0.015em;
  }
  .story__dek {
    font-family: var(--f-serif);
    font-size: var(--fs-lg);
    line-height: 1.4;
    color: var(--c-ink-2);
  }
  .story__figure {
    margin-bottom: var(--sp-7);
  }
  .story__figure img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--c-bg-alt);
  }
  .story__figure figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-2);
    padding-top: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .story__credit::before {
    content: '·';
    margin-right: var(--sp-2);
  }
  .story__body,
  .story__footer,
  .story__main > :global(.help) {
    max-width: var(--w-read);
  }
  .story__main > :global(.help) {
    margin-bottom: var(--sp-7);
  }
  .story__footer {
    display: grid;
    gap: var(--sp-7);
    margin-top: var(--sp-8);
  }

  /* Rail */
  .story__rail-sticky {
    position: sticky;
    top: 4.5rem;
    display: grid;
    gap: var(--sp-7);
  }
  .story__toc .label {
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--c-ink);
  }
  .story__toc ol {
    font-size: var(--fs-sm);
  }
  .story__toc li {
    border-bottom: 1px solid var(--c-rule);
  }
  .story__toc a {
    display: block;
    padding-block: var(--sp-2);
    text-decoration: none;
  }
  .story__toc a:hover {
    color: var(--c-accent);
  }

  /* Mobile table of contents */
  .story__toc-mobile {
    display: none;
    max-width: var(--w-read);
    margin-bottom: var(--sp-6);
    border-block: 1px solid var(--c-rule);
    font-size: var(--fs-sm);
  }
  .story__toc-mobile summary {
    padding-block: var(--sp-3);
    font-weight: 700;
    cursor: pointer;
  }
  .story__toc-mobile ol {
    margin: 0 0 var(--sp-3);
    padding-left: 1.25em;
  }
  .story__toc-mobile li + li {
    margin-top: var(--sp-2);
  }

  .more {
    margin-top: var(--sp-9);
  }

  @media (max-width: 64rem) {
    .story {
      grid-template-columns: minmax(0, 1fr);
    }
    .story__rail {
      display: none;
    }
    .story__toc-mobile {
      display: block;
    }
  }
</style>
