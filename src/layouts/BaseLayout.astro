---
import { Font } from 'astro:assets';
import '../styles/index.css';

import SEO, { type SeoProps } from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import HelplineBar from '../components/help/HelplineBar.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { ADSENSE, adsEnabled, SITE } from '../config/site';
import { graph } from '../lib/seo';

interface Props {
  seo: SeoProps;
  /** Extra JSON-LD nodes (Article, BreadcrumbList, CollectionPage…). */
  jsonLd?: Record<string, unknown>[];
  /** Highlights the active section in the navigation. */
  activeSection?: string;
  /**
   * Whether this page may carry ads. False on sensitive articles, crisis resources,
   * legal pages and errors: the AdSense script is not even loaded there.
   */
  ads?: boolean;
}

const { seo, jsonLd = [], activeSection, ads = true } = Astro.props;
const loadAdsense = ads && adsEnabled;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Preload only above-the-fold faces: serif headlines (600) and UI text (400). -->
    <Font cssVariable="--font-newsreader" preload={[{ weight: 600, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-franklin" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <SEO {...seo} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    {
      loadAdsense && (
        <>
          <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
          <script
            is:inline
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`}
            crossorigin="anonymous"
          />
        </>
      )
    }
    <JsonLd data={graph(...jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <HelplineBar />
    <Header activeSection={activeSection} />
    <main id="main" class="min-h-[50vh]">
      <slot />
    </main>
    <Footer />
    {
      loadAdsense && (
        <script is:inline>
          document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])').forEach(function () {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          });
        </script>
      )
    }
  </body>
</html>
